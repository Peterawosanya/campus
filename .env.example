# Local development secrets. Copy to server/.env and adjust if needed.
# Never commit server/.env to git.

# PostgreSQL (used by docker-compose.yml and the Fastify server)
POSTGRES_USER=campusos
POSTGRES_PASSWORD=campusos_local
POSTGRES_DB=campusos
POSTGRES_PORT=5432

# Connection string used by the Fastify server / Drizzle.
# On Windows PowerShell, use localhost; inside Docker use host db.
DATABASE_URL=postgres://campusos:campusos_local@localhost:5432/campusos

# Fastify
PORT=3001
HOST=127.0.0.1
